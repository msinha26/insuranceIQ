# PolicySaathi — environment variables
# Copy this file to policysaathi/.env.local and fill in real values.
# Nothing here should ever have a real secret committed to source control.
# No Supabase anywhere in this project — see docs/engineering/engineering-doc.md's architecture note.

# ---------------------------------------------------------------------------
# MongoDB (app data + GridFS — docs/specs/mongodb-schema.md)
# ---------------------------------------------------------------------------
MONGODB_URI=                              # SERVER ONLY — the app's own connection string to the shared MongoDB deployment
MONGODB_DB_NAME=policysaathi              # database name for this app's own collections (kept separate from generalQuestionsCollection's own db/namespace if it differs)

# ---------------------------------------------------------------------------
# Session auth (custom — no Supabase Auth, docs/specs/auth-otp.md)
# ---------------------------------------------------------------------------
SESSION_JWT_SECRET=                       # SERVER ONLY — signs/verifies the app's own session cookie
SESSION_JWT_EXPIRY_DAYS=30                # FR-01's 30-day persistence
OTP_CODE_TTL_SECONDS=300                  # how long a sent OTP code stays valid (5 minutes)

# ---------------------------------------------------------------------------
# n8n (self-hosted, AWS Mumbai ap-south-1 — see engineering-doc.md §7)
# ---------------------------------------------------------------------------
N8N_INGESTION_WEBHOOK_URL=                # SERVER ONLY — https://<n8n-host>/webhook/document_ingestion
N8N_RAG_WEBHOOK_URL=                      # SERVER ONLY — https://<n8n-host>/webhook/document_retrieval
N8N_WEBHOOK_SECRET=                       # SERVER ONLY — sent as X-PolicySaathi-Secret; also configured as n8n's Header Auth credential

# ---------------------------------------------------------------------------
# Razorpay (UPI payments — docs/specs/payments-razorpay.md)
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=                          # Razorpay Dashboard > Settings > API Keys
RAZORPAY_KEY_SECRET=                      # SERVER ONLY — Razorpay Dashboard > Settings > API Keys
RAZORPAY_WEBHOOK_SECRET=                  # SERVER ONLY — Razorpay Dashboard > Settings > Webhooks, used to verify payment.captured/failed signatures

# ---------------------------------------------------------------------------
# SMS / WhatsApp OTP (docs/specs/auth-otp.md)
# ---------------------------------------------------------------------------
MSG91_AUTH_KEY=                           # SERVER ONLY — MSG91 dashboard; primary SMS OTP provider
MSG91_OTP_FLOW_ID=                        # MSG91 > Campaigns > Flows — DLT-approved SMS template with an OTP variable
MSG91_WHATSAPP_API_KEY=                   # SERVER ONLY — MSG91/Gupshup WhatsApp Business API key, WhatsApp OTP fallback
MSG91_WHATSAPP_TEMPLATE_NAME=             # Name of the approved WhatsApp template used to deliver the OTP code
MSG91_WHATSAPP_NAMESPACE=                 # WhatsApp Business template namespace, from the MSG91 WhatsApp dashboard
MSG91_WHATSAPP_INTEGRATED_NUMBER=         # The WhatsApp Business number integrated with MSG91 (sender)
TWILIO_ACCOUNT_SID=                       # Twilio Console — secondary/fallback SMS OTP provider
TWILIO_AUTH_TOKEN=                        # SERVER ONLY — Twilio Console
TWILIO_PHONE_NUMBER=                      # Twilio phone number to send the fallback SMS from (plain SMS, not Twilio Verify — this app issues its own OTP code so the same code must work regardless of delivery channel)
ALLOW_OTP_DEV_BYPASS=                     # "true" to allow the fixed-code OTP bypass on a deployed-but-pre-Stage-7 environment with no SMS provider set up. Remove before inviting real users — see src/lib/auth/otp-delivery.ts.

# ---------------------------------------------------------------------------
# Limits (not secrets, but centralized here so they're not hard-coded in multiple places)
# ---------------------------------------------------------------------------
MAX_UPLOAD_FILE_SIZE_MB=5                 # docs/specs/upload-api.md — PDF travels as base64 in the n8n webhook body, so this stays small
MAX_POLICY_PAGE_COUNT=60                  # docs/specs/upload-api.md
MAX_DOCUMENTS_PER_POLICY=3                # docs/specs/upload-api.md

# ---------------------------------------------------------------------------
# Configured in n8n, not in this file
# (set directly in n8n's own credential store — never committed to the repo)
# ---------------------------------------------------------------------------
# - Azure Document Intelligence endpoint + API key (OCR, docs/specs/n8n-ingestion-workflow.md)
# - OpenAI API key (LLM + embeddings, both n8n flows)
# - Anthropic API key (fallback LLM provider, docs/specs/n8n-rag-workflow.md)
# - PolicySaathi MongoDB credential (n8n's own direct-write access to documents/snapshot_terms/
#   policies.status, plus read access to generalQuestionsCollection — docs/specs/n8n-ingestion-workflow.md,
#   docs/specs/n8n-rag-workflow.md). Same deployment as MONGODB_URI above, separate credential.
# - Snowflake account connection (read-only access to POLICY_DB.PUBLIC.CLAIMS_PLAYBOOK —
#   docs/specs/playbook-schema-retrieval.md). Pre-existing, SME-managed; this app never writes to it.
